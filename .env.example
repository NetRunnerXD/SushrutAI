# ---------- Core ----------
SUSHRUT_ENV=dev
# SQLite works out of the box (no Docker). For Postgres+pgvector use:
# DATABASE_URL=postgresql+asyncpg://sushrut:sushrut@localhost:5432/sushrut
DATABASE_URL=sqlite+aiosqlite:///./data/sushrut.db
# Local encrypted file storage for uploads (MinIO/S3 later)
STORAGE_DIR=./data/storage
# 32-byte base64 master key (KEK). If empty, one is generated into ./data/master.key
# and protected with Windows DPAPI when available.
MASTER_KEY_B64=
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# ---------- Local models (Ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=medgemma:4b
VLM_MODEL=medgemma:4b
# Prescription reader: best of 3 on the real-Rx eval (eval/rx_eval.py). ollama pull qwen3-vl:4b-instruct
RX_VLM_MODEL=qwen3-vl:4b-instruct
EMBED_MODEL=bge-m3
GUARD_MODEL=llama-guard3:1b

# ---------- Free / freemium APIs (all optional) ----------
# Groq free tier — only receives de-identified text with cloud_llm_deidentified consent
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
# Sarvam AI (India-hosted) — STT/TTS/translation, free starter credits
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=anushka
# Gemini (Google AI Studio): the "Gemini" answer models. Sends full questions, health context and photos to
# Google when the person chooses Gemini (consent cloud_llm_full). See docs/API_KEYS.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_FLASH_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TRANSCRIBE_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSLATE_LIVE_MODEL=gemini-3.5-live-translate-preview
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
# ElevenLabs: cloud voice engine (listening + read-aloud) when the person chooses it (consent cloud_voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# Google Places (New): fills missing hospital phone numbers in the emergency sheet (optional)
GOOGLE_PLACES_API_KEY=
# Memory housekeeping: Ollama keep-alive per model kind, and idle release of speech / translation models
KEEP_ALIVE_CHAT=10m
KEEP_ALIVE_VISION=2m
SPEECH_IDLE_UNLOAD_S=600
# The chat asks 1-3 questions before naming possibilities (off: answer at once, as before)
CHAT_DIFFERENTIAL=on
# Bhashini / ULCA (Govt of India) — free Indic ASR/NMT/TTS
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# openFDA — key optional (raises rate limits)
OPENFDA_API_KEY=

# ---------- OTP delivery ----------
# Email OTP via any SMTP (Brevo free tier: smtp-relay.brevo.com:587, or Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Phone OTP via Firebase Authentication (verify the Firebase ID token server-side)
FIREBASE_PROJECT_ID=
