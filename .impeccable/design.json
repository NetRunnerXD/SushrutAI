  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one next step on a view: jamun, 48px, presses down a pixel.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Taken</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:14px;padding:.6rem 1.15rem;min-height:48px;min-width:48px;font:700 1.0625rem/1.2 'Noto Sans',system-ui,sans-serif;border:0;cursor:pointer;transition:background-color .15s,transform .12s,box-shadow .15s}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid #5B2A7A;outline-offset:2px}.ds-btn-primary{background:#5B2A7A;color:#FFFFFF;box-shadow:inset 0 1px 0 rgb(255 255 255 / 18%),0 1px 2px rgb(24 32 40 / 7%),0 6px 16px -10px rgb(24 32 40 / 26%)}.ds-btn-primary:hover{background:#46205F}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions: polished lid with a 1.5px input rule and the rim.",
      "html": "<button class=\"ds-btn-outline\">Say again</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;border-radius:14px;padding:.6rem 1.15rem;min-height:48px;font:700 1.0625rem/1.2 'Noto Sans',system-ui,sans-serif;background:#F3F5F7;color:#182028;border:1.5px solid #6F7B86;box-shadow:inset 0 1.5px 0 #FFFFFF,inset 0 -1px 0 rgb(24 32 40 / 5%);cursor:pointer;transition:background-color .15s,transform .12s}.ds-btn-outline:hover{background:#DCE1E5}.ds-btn-outline:active{transform:translateY(1px)}.ds-btn-outline:focus-visible{outline:3px solid #5B2A7A;outline-offset:2px}"
    },
    {
      "name": "Emergency Button",
      "kind": "button",
      "refersTo": "button-emergency",
      "description": "SOS and emergency calls only: solid emergency red, white text.",
      "html": "<button class=\"ds-btn-sos\">SOS</button>",
      "css": ".ds-btn-sos{display:inline-flex;align-items:center;justify-content:center;border-radius:14px;padding:.6rem 1.15rem;min-height:48px;min-width:48px;font:700 1.0625rem/1.2 'Noto Sans',system-ui,sans-serif;background:#B3121B;color:#FFFFFF;border:0;cursor:pointer;transition:filter .15s,transform .12s}.ds-btn-sos:hover{filter:brightness(1.1)}.ds-btn-sos:active{transform:translateY(1px)}.ds-btn-sos:focus-visible{outline:3px solid #5B2A7A;outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "48px polished-lid field; focus turns the border jamun with a soft halo.",
      "html": "<input class=\"ds-input\" placeholder=\"Ask about a symptom or a medicine\" />",
      "css": ".ds-input{width:100%;max-width:22rem;background:#F3F5F7;border:1.5px solid #6F7B86;border-radius:12px;padding:.65rem .85rem;min-height:48px;color:#182028;font:400 1rem/1.6 'Noto Sans',system-ui,sans-serif;caret-color:#5B2A7A;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:#4C5762}.ds-input:focus{outline:none;border-color:#5B2A7A;box-shadow:0 0 0 3px #EEE5F4}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "48px pill toggles; selected is a jamun border on jamun soft with a check.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"false\">Fever</button><button class=\"ds-chip ds-chip-on\" aria-pressed=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#4C5762\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Headache</button></div>",
      "css": ".ds-chips{display:flex;gap:.5rem;flex-wrap:wrap}.ds-chip{display:inline-flex;align-items:center;gap:.5rem;min-height:48px;padding:0 1rem;border-radius:9999px;border:1.5px solid #6F7B86;background:#F3F5F7;color:#182028;font:600 1rem/1 'Noto Sans',system-ui,sans-serif;box-shadow:inset 0 1.5px 0 #FFFFFF;cursor:pointer;transition:background-color .15s}.ds-chip:hover{background:#DCE1E5}.ds-chip-on{border-color:#5B2A7A;background:#EEE5F4;box-shadow:none}.ds-chip:focus-visible{outline:3px solid #5B2A7A;outline-offset:2px}"
    },
    {
      "name": "Card (Lid)",
      "kind": "card",
      "refersTo": "card",
      "description": "Polished lid with a rolled white rim, hairline border and soft cool E1; katori icon in the header.",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-head\"><span class=\"ds-katori\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/></svg></span><div><h2 class=\"ds-h2\">Health snapshot</h2><p class=\"ds-sub\">Updated today</p></div></div><p class=\"ds-body\">Blood pressure has been in range all week.</p></section>",
      "css": ".ds-card{max-width:24rem;background:#F3F5F7;border:1px solid #C3CBD2;border-radius:18px;padding:20px;box-shadow:inset 0 1.5px 0 #FFFFFF,inset 0 -1px 0 rgb(24 32 40 / 5%),0 1px 2px rgb(24 32 40 / 7%),0 6px 16px -10px rgb(24 32 40 / 26%);color:#182028;font-family:'Noto Sans',system-ui,sans-serif}.ds-card-head{display:flex;gap:.75rem;align-items:center;margin-bottom:.75rem}.ds-katori{display:grid;place-items:center;width:40px;height:40px;border-radius:9999px;background:#DCE1E5;box-shadow:inset 0 2px 5px rgb(24 32 40 / 17%),inset 0 -1px 0 rgb(255 255 255 / 75%)}.ds-h2{margin:0;font:700 1.25rem/1.3 Mukta,'Noto Sans',sans-serif;letter-spacing:-.01em}.ds-sub{margin:0;font-size:.9375rem;color:#4C5762}.ds-body{margin:0;line-height:1.6}"
    },
    {
      "name": "Dabba",
      "kind": "custom",
      "refersTo": "dabba-katori-next",
      "description": "Signature: the day's three dose katoris; the next is jamun, a taken katori fills dhania.",
      "html": "<div class=\"ds-dabba\"><div class=\"ds-slot\"><span class=\"ds-k ds-k-done\"><svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M32 6 9 17l-5-5\"/></svg></span><b>Morning</b></div><div class=\"ds-slot\"><span class=\"ds-k ds-k-next\">0/1</span><b>Afternoon</b></div><div class=\"ds-slot\"><span class=\"ds-k\">0/2</span><b>Night</b></div></div>",
      "css": ".ds-dabba{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:22rem;padding:16px;background:#F3F5F7;border:1px solid #C3CBD2;border-radius:24px;box-shadow:inset 0 1.5px 0 #FFFFFF,0 6px 16px -10px rgb(24 32 40 / 26%);font-family:'Noto Sans',system-ui,sans-serif;color:#182028}.ds-slot{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:.875rem}.ds-k{display:grid;place-items:center;width:100%;max-width:6.5rem;aspect-ratio:1;border-radius:9999px;background:#DCE1E5;box-shadow:inset 0 2px 5px rgb(24 32 40 / 17%),inset 0 -1px 0 rgb(255 255 255 / 75%);font:700 1.75rem/1 'Noto Sans',sans-serif;font-variant-numeric:tabular-nums}.ds-k-next{background:#5B2A7A;color:#FFFFFF;box-shadow:inset 0 3px 6px rgb(0 0 0 / 25%),0 0 0 4px #EEE5F4}.ds-k-done{background:#2B6634;color:#FFFFFF;box-shadow:inset 0 3px 6px rgb(0 0 0 / 22%);animation:ds-fill .22s cubic-bezier(.16,1,.3,1) both}@keyframes ds-fill{from{transform:scale(.55);opacity:.4}to{transform:none;opacity:1}}"
    },
    {
      "name": "Family Tiers",
      "kind": "nav",
      "refersTo": "family-tier",
      "description": "Signature: one tier per person on gunmetal with a spice dot; the open record's tier is engraved and lifted.",
      "html": "<nav class=\"ds-tiers\" aria-label=\"Whose health\"><button class=\"ds-tier ds-tier-on\" aria-current=\"true\"><i style=\"background:#C98A0A\"></i>Myself</button><button class=\"ds-tier\"><i style=\"background:#4F7A3A\"></i>Amma</button><button class=\"ds-tier\"><i style=\"background:#C45A16\"></i>Riya</button></nav>",
      "css": ".ds-tiers{display:flex;align-items:flex-end;gap:4px;padding:8px 12px 0;background:#232B33;font-family:'Noto Sans',system-ui,sans-serif}.ds-tier{display:flex;align-items:center;gap:8px;min-height:48px;padding:0 14px;border:0;border-radius:14px 14px 0 0;background:#313A43;color:#B1BBC4;font-size:.9375rem;font-weight:600;cursor:pointer}.ds-tier:hover{color:#EEF1F3}.ds-tier i{width:12px;height:12px;border-radius:9999px;display:block}.ds-tier-on{background:#E4E8EB;color:#182028;font-weight:800;text-transform:uppercase;letter-spacing:.06em;box-shadow:inset 0 1.5px 0 #FFFFFF;animation:ds-lid .2s cubic-bezier(.16,1,.3,1) both}.ds-tier:focus-visible{outline:3px solid #D7BCEB;outline-offset:2px}@keyframes ds-lid{from{transform:translateY(6px);opacity:.55}to{transform:none;opacity:1}}"
    },
    {
      "name": "Bottom Tab Bar",
      "kind": "nav",
      "refersTo": "rail-link-current",
      "description": "Phone navigation; the current place is a filled jamun katori.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-tab-on\" aria-current=\"page\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z\"/></svg></span>Home</a><a class=\"ds-tab\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z\"/></svg></span>Ask</a><a class=\"ds-tab\"><span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"9\" width=\"18\" height=\"6\" rx=\"3\"/><path d=\"M12 9v6\"/></svg></span>Medicines</a></nav>",
      "css": ".ds-tabs{display:flex;max-width:24rem;background:#F3F5F7;border-top:1px solid #C3CBD2;box-shadow:0 -8px 24px -16px rgb(24 32 40 / 40%);font-family:'Noto Sans',system-ui,sans-serif}.ds-tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-height:64px;font-size:.78rem;font-weight:600;color:#4C5762;cursor:pointer;text-decoration:none}.ds-tab span{display:grid;place-items:center;width:36px;height:36px;border-radius:9999px}.ds-tab-on{color:#5B2A7A;font-weight:700}.ds-tab-on span{background:#5B2A7A;color:#FFFFFF}.ds-tab:hover{color:#182028}.ds-tab:focus-visible{outline:3px solid #5B2A7A;outline-offset:2px}"
    },
    {
      "name": "Urgency Banner",
      "kind": "custom",
      "refersTo": "button-danger",
      "description": "Full 1.5px border plus tint, never a side stripe. Shown: see a doctor within 24 hours.",
      "html": "<div class=\"ds-banner\" role=\"alert\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 8v4M12 16h.01\"/></svg><div><p class=\"ds-banner-t\">See a doctor within 24 hours</p><p class=\"ds-banner-b\">Specialist: <b>General physician</b></p></div></div>",
      "css": ".ds-banner{display:flex;gap:12px;max-width:26rem;padding:16px;border-radius:16px;border:1.5px solid #A5221A;background:#F6DDD9;color:#A5221A;font-family:'Noto Sans',system-ui,sans-serif}.ds-banner svg{flex-shrink:0;margin-top:2px}.ds-banner-t{margin:0;font:700 1.125rem/1.35 Mukta,'Noto Sans',sans-serif}.ds-banner-b{margin:0;font-size:.9375rem;line-height:1.6}"
    }
  ],
  "narrative": {
    "northStar": "The Steel Tiffin",
    "overview": "The household's health is kept the way an Indian home keeps its steel: one stacked tiffin carrier with a tier per person, and a dabba of round katoris for each day's medicines. Surfaces are brushed and polished steel, cool and calm, with a bright rolled rim along the top edge and round pressed wells for every slot. Colour does not decorate; it codes. Each person in the family owns one spice colour, jamun purple means \"your next step\", and red means only emergency or urgent.\n\nDensity is low and the hand is generous: 17px root type, 48px minimum targets, one clear next step per view. The shell is gunmetal (a side rail on tablet and desktop, a header on phone) with the family tiers hanging from it, so whose record is open is never in doubt. Motion is a lid lifting and settling: short vertical moves, no tilt and no bounce.\n\nThe system rejects the white-and-teal card stack of generic health apps and the cream paper notebook it replaced.",
    "keyCharacteristics": [
      "Cool brushed-steel ground, polished lids with a white top highlight, round inset katori wells.",
      "Spice colours as identity codes, one per family member; haldi is always the account holder.",
      "Jamun purple reserved for the primary action, the next dose and the current place.",
      "Red only for emergency and urgent states; SOS always visible.",
      "Mukta headings over a ten-script Noto Sans body, tabular numerals everywhere numbers matter.",
      "Rounded vessel radii (12px to 24px) and full circles for slots and marks."
    ],
    "rules": [
      {
        "name": "The One Next Step Rule",
        "body": "Jamun marks the user's next step: the primary action, the next dose, the current place. If two things on a screen are jamun, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Spice Is a Person Rule",
        "body": "A spice colour always means a household member and is assigned by the family order, never chosen for decoration. Haldi is the account holder.",
        "section": "colors"
      },
      {
        "name": "The Red Means Now Rule",
        "body": "Emergency Red appears only on SOS and emergency urgency. Danger Red appears only as a tint with a full border for urgent states and destructive actions.",
        "section": "colors"
      },
      {
        "name": "The One Numeral Scale Rule",
        "body": "Every number a person acts on (a dose, a time, a reading) uses tabular lining figures in the body face. No separate monospace family.",
        "section": "typography"
      },
      {
        "name": "The Root Scales Everything Rule",
        "body": "Sizes are in rem from a 17px root; large text sets the root to 21px or 24px (`data-text=\"lg\" | \"xl\"`) and the whole interface scales with it.",
        "section": "typography"
      },
      {
        "name": "The Lid and Well Rule",
        "body": "Things you read sit on a lid (rim plus E1). Things that hold a value or a slot are pressed into a well. Do not invert them.",
        "section": "elevation"
      },
      {
        "name": "The Steel Light Rule",
        "body": "Shadows are cool (steel-ink based, never pure black on light), soft and low. No hard offset shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep SOS visible in the header on every screen, in simple mode, and with the keyboard open.",
      "Do use the one urgency scale everywhere: emergency (solid red), see a doctor in 24 hours (danger tint plus full border), this week (warn), self care (ok).",
      "Do give every banner a full 1.5px border and a tint of its tone.",
      "Do show the \"Information, not a diagnosis\" disclaimer wherever health guidance appears.",
      "Do make every target at least 48px and keep the 3px jamun focus ring with a 2px offset.",
      "Do drive preferences through attributes on `<html>`: `data-text`, `data-theme`, `data-contrast`, `data-motion`, `data-sidebar`, applied before first paint.",
      "Do honour simple mode: fewer destinations, bigger Home, everything read aloud.",
      "Do keep print styles: always light, ink-friendly, no app chrome.",
      "Do check every screen at 360px with no horizontal page scroll.",
      "Do put shared component classes in `@layer components` so utilities win.",
      "Do put slots and small marks in round katori wells and readable content on rimmed lids."
    ],
    "donts": [
      "Don't use jamun for anything but the next step; never two jamun primary actions on one view.",
      "Don't use a spice colour for anything but a household member, or as text on steel.",
      "Don't use red outside emergency, urgent and destructive states, and never solid danger red for a destructive button.",
      "Don't use a side stripe on banners or alerts.",
      "Don't add tilt, bounce or looping motion beyond the listening voice well and loading indicators.",
      "Don't fall back to the white-and-teal card stack or the cream paper notebook look.",
      "Don't use hard offset shadows or pure black shadows on the light theme."
    ]
  }
}
