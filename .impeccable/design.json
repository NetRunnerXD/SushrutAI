        "purpose": "Voice well and voice-confirm panel."
      },
      {
        "name": "e3",
        "value": "0 4px 10px rgb(24 32 40 / 10%), 0 28px 56px -20px rgb(24 32 40 / 48%)",
        "purpose": "Sheets and dialogs."
      },
      {
        "name": "focus-ring",
        "value": "outline: 3px solid var(--focus); outline-offset: 2px",
        "purpose": "Global focus-visible ring, never removed; fields use a jamun border plus 0 0 0 3px jamun-soft."
      }
    ],
    "motion": [
      {
        "name": "ease-lid",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Exponential ease-out for every lift, fill and sheet."
      },
      {
        "name": "lid",
        "value": "translateY(6px) to none, opacity 0.55 to 1, 200ms",
        "purpose": "Active family tier and confirm panels lift and settle."
